<?xml version="1.0" encoding="utf-8"?>
<!-- Jollyboat's Windows downloads, as the release workflow sends them to SignPath (a zip of the
     three exes; .github/workflows/build.yml). Paste this into the SignPath project's artifact
     configuration. The version comes from the workflow (the `version` parameter). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Jollyboat-${version}-windows-universal-setup.exe" product-name="Jollyboat" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="Jollyboat-${version}-windows-x64-portable.exe" product-name="Jollyboat" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="Jollyboat-${version}-windows-arm64-portable.exe" product-name="Jollyboat" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
